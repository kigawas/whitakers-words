{
  "name": "whitakers-words",
  "version": "0.1.3",
  "description": "Latin morphological analyzer and dictionary: A modern TypeScript port of Whitaker's Words",
  "author": {
    "name": "Weiliang Li",
    "email": "to.be.impressive@gmail.com",
    "url": "https://github.com/kigawas"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kigawas/whitakers-words.git"
  },
  "keywords": [
    "latin",
    "dictionary",
    "classics"
  ],
  "type": "module",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "default": "./dist/lib/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    }
  },
  "files": [
    "dist/",
    "data/",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "whitakers": "dist/cli/main.js"
  },
  "scripts": {
    "build": "tsc",
    "check": "biome check",
    "check:fix": "biome check --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:browser": "node ./scripts/gen-browser-tests.mjs && cd tests-browser && pnpm test",
    "test:ada": "node ./scripts/ada-compat-check.mjs",
    "test:ada:verbose": "node ./scripts/ada-compat-check.mjs --verbose"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.34.7+sha512.ba98abc585539933375b5971f4bc6d6c73a1b4b7edc4a879e7d102fe5423d1e02309d67c60a11f04955093a96e521ad9c3b138cdd654ca5be563f378b3ae48bd"
}
