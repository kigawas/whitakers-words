{
  "name": "whitakers-words",
  "version": "0.1.2",
  "author": {
    "name": "Weiliang Li",
    "email": "to.be.impressive@gmail.com",
    "url": "https://github.com/kigawas"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kigawas/whitakers-words.git"
  },
  "keywords": [
    "latin",
    "dictionary",
    "classics"
  ],
  "type": "module",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "default": "./dist/lib/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    }
  },
  "files": [
    "dist/",
    "data/",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "whitakers": "dist/cli/main.js"
  },
  "scripts": {
    "build": "tsc",
    "check": "biome check",
    "check:fix": "biome check --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:browser": "node ./scripts/gen-browser-tests.mjs && cd tests-browser && pnpm test",
    "test:ada": "node ./scripts/ada-compat-check.mjs",
    "test:ada:verbose": "node ./scripts/ada-compat-check.mjs --verbose"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "^4.1.9",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.34.1+sha512.b58fbde6dca66a929538021581f648b4570b6ca19b18e7cbd7f2c07a7b24454155388dacdf08f2af3678e88a6d1fe04f9d609df24bf51735a060ea041b374ab7"
}
